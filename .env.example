# Copy to .env (never commit .env)
APP_ENV=development
POSTGRES_PASSWORD=  # required by docker-compose (VPS only; local dev can use SQLite)
DATABASE_URL=postgresql+asyncpg://wbweb:wbweb@localhost:5432/wbweb
FERNET_KEY=  # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_SESSION=  # random hex, >=32 bytes
SENTRY_DSN=
OWNER_EMAILS=  # comma-separated emails with owner access to /admin (+ JSON API)
ADMIN_SUPPORT_EMAILS=  # comma-separated read-only support admins
PUBLIC_BASE_URL=  # e.g. https://aimanager.kg — used in emailed magic links
MAIL_FROM=AImanager <no-reply@yourdomain.kg>
SMTP_HOST=  # empty = console backend (dev); set for real delivery
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
PRICE_STARTER=
PRICE_PRO=
PRICE_BUSINESS=
